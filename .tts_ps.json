[{"teks": "Cambridge, dua puluh delapan Juni dua ribu sembilan. Fisikawan Stephen Hawking menggelar sebuah pesta di universitasnya, dengan tamu yang sangat khusus: para penjelajah waktu.", "kata": [["Cambridge", 0.111291, 0.699541], ["dua", 0.956875, 1.140666], ["puluh", 1.140666, 1.324499], ["delapan", 1.3245, 1.643125], ["Juni", 1.643125, 1.9495], ["dua", 1.9495, 2.133333], ["ribu", 2.133333, 2.292666], ["sembilan", 2.292666, 2.905416], ["Fisikawan", 3.73775, 4.227958], ["Stephen", 4.227958, 4.522041], ["Hawking", 4.522041, 4.852916], ["menggelar", 4.852958, 5.171583], ["sebuah", 5.171583, 5.477958], ["pesta", 5.477958, 5.808833], ["di", 5.808833, 5.894624], ["universitasnya", 5.894625, 6.911791], ["dengan", 7.169125, 7.438708], ["tamu", 7.438708, 7.696041], ["yang", 7.696083, 7.818624], ["sangat", 7.818625, 8.075958], ["khusus", 8.076, 8.578458], ["para", 8.78675, 9.019583], ["penjelajah", 9.019625, 9.546583], ["waktu", 9.546583, 10.061291]]}, {"teks": "Triknya cerdik. Undangan pesta itu baru disebarkan setelah pestanya selesai, jadi tanggal di dalamnya sudah lama lewat.", "kata": [["Triknya", 0.1, 0.528916], ["cerdik", 0.528916, 1.153916], ["Undangan", 1.985291, 2.340666], ["pesta", 2.340666, 2.561249], ["itu", 2.561291, 2.806374], ["baru", 2.806375, 2.977958], ["disebarkan", 2.977958, 3.504916], ["setelah", 3.504916, 3.786749], ["pestanya", 3.78675, 4.129875], ["selesai", 4.129916, 4.754916], ["jadi", 5.0245, 5.294125], ["tanggal", 5.294125, 5.6005], ["di", 5.6005, 5.674], ["dalamnya", 5.674, 6.053916], ["sudah", 6.053916, 6.298999], ["lama", 6.299, 6.482833], ["lewat", 6.482833, 6.973041]]}, {"teks": "Artinya, hanya orang dari masa depan yang bisa membaca undangan itu, lalu memutar waktu kembali ke hari pesta.", "kata": [["Artinya", 0.111291, 0.760791], ["hanya", 1.018125, 1.263208], ["orang", 1.26325, 1.471583], ["dari", 1.471583, 1.594124], ["masa", 1.594125, 1.790208], ["depan", 1.790208, 2.059791], ["yang", 2.059791, 2.194582], ["bisa", 2.194625, 2.402958]