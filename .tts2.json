[{"teks": "Kenapa bom atom bisa menghasilkan daya ledak yang luar biasa? Kita bongkar sebongkah logam uranium ini, sampai ke dalam atomnya.", "kata": [["Kenapa", 0.096541, 0.398249], ["bom", 0.398291, 0.559916], ["atom", 0.559916, 0.861624], ["bisa", 0.861625, 1.044833], ["menghasilkan", 1.044833, 1.518958], ["daya", 1.518958, 1.691374], ["ledak", 1.691375, 1.939208], ["yang", 1.939208, 2.057749], ["luar", 2.05775, 2.208625], ["biasa", 2.208625, 2.715083], ["Kita", 3.430166, 3.645666], ["bongkar", 3.645708, 3.925874], ["sebongkah", 3.925875, 4.281458], ["logam", 4.281458, 4.507749], ["uranium", 4.50775, 4.82025], ["ini", 4.82025, 5.218958], ["sampai", 5.466791, 5.811624], ["ke", 5.811625, 5.887041], ["dalam", 5.887083, 6.081041], ["atomnya", 6.081041, 6.619832]]}, {"teks": "Dinamit meledak karena atom-atomnya hanya menata ulang ikatan. Pada bom atom, yang berubah adalah inti atomnya sendiri.", "kata": [["Dinamit", 0.096541, 0.484457], ["meledak", 0.4845, 0.80775], ["karena", 0.80775, 1.0125], ["atom-atomnya", 1.0125, 1.594416], ["hanya", 1.594416, 1.842249], ["menata", 1.84225, 2.100875], ["ulang", 2.100875, 2.305583], ["ikatan", 2.305583, 2.844374], ["Pada", 3.566791, 3.749999], ["bom", 3.75, 3.900875], ["atom", 3.900875, 4.331916], ["yang", 4.601291, 4.762916], ["berubah", 4.762916, 5.064624], ["adalah", 5.064666, 5.312499], ["inti", 5.3125, 5.528], ["atomnya", 5.528, 5.851291], ["sendiri", 5.851291, 6.379291]]}, {"teks": "Satu neutron menumbuk inti uranium tertentu dan membelahnya. Inilah fisi. Ia melepas panas, dan dua atau tiga neutron baru.", "kata": [["Satu", 0.096541, 0.365957], ["neutron", 0.365958, 0.732333], ["menumbuk", 0.732333, 1.023291], ["inti", 1.023291, 1.206457], ["uranium", 1.206458, 1.518958], ["tertentu", 1.518958, 1.971541], ["dan", 1.971541, 2.154749], ["membelahnya", 2.15475, 2.747416], ["Inilah", 3.465958, 3.886208], ["fisi", 3.886208, 4.381916], ["Ia", 5.10775, 5.258625], ["melepas", 5.258625, 5.549583], ["panas", 5.549583, 6.002166], ["dan", 6.228458, 6.433208], ["dua", 6.433208, 6.648708], ["atau", 6.648708, 6.842666], ["tiga", 6.842666, 7.090499], ["neutron", 7.0905, 7.403], ["baru", 7.403, 7.780166]]}, {"teks": "Neutron baru membelah inti lain, lalu berlipat ganda dalam sekejap. Inilah reaksi berantai.", "kata": [["Neutron", 0.103875, 0.405583], ["baru", 0.405583, 0.599541], ["membelah", 0.599583, 0.847416], ["inti", 0.847416, 1.019832], ["lain", 1.019833, 1.440083], ["lalu", 1.698708, 1.935791], ["berlipat", 1.935791, 2.280582], ["ganda", 2.280583, 2.593083], ["dalam", 2.593083, 2.787041], ["sekejap", 2.787083, 3.293541], ["Inilah", 4.013791, 4.390957], ["reaksi", 4.390958, 4.703458], ["berantai", 4.703458, 5.306916]]}, {"teks": "Saat membelah, sebagian kecil massa inti hilang, dan berubah jadi energi. Rumusnya, E sama dengan m c kuadrat. Karena c kuadrat angkanya sangat besar, massa sedikit pun jadi energi luar biasa.", "kata": [["Saat", 0.096541, 0.365957], ["membelah", 0.365958, 0.872416], ["sebagian", 1.077166, 1.465082], ["kecil", 1.465083, 1.702166], ["massa", 1.702166, 1.896124], ["inti", 1.896125, 2.079291], ["hilang", 2.079291, 2.510332], ["dan", 2.747416, 2.941374], ["berubah", 2.941375, 3.243083], ["jadi", 3.243083, 3.458583], ["energi", 3.458625, 3.997416], ["Rumusnya", 4.714208, 5.382291], ["E", 5.619416, 5.716374], ["sama", 5.716375, 5.985791], ["dengan", 5.985791, 6.212082], ["m", 6.212083, 6.373708], ["c", 6.373708, 6.513791], ["kuadrat", 6.513791, 7.020249], ["Karena", 7.747833, 8.038791], ["c", 8.038791, 8.178874], ["kuadrat", 8.178875, 8.502166], ["angkanya", 8.502166, 8.803874], ["sangat", 8.803875, 9.030166], ["besar", 9.030166, 9.471957], ["massa", 9.709041, 9.935332], ["sedikit", 9.935333, 10.247833], ["pun", 10.247833, 10.398708], ["jadi", 10.398708, 10.571124], ["energi", 10.571125, 10.883625], ["luar", 10.883625, 11.056041], ["biasa", 11.056041, 11.573291]]}, {"teks": "Energi sebesar itu terlepas dalam waktu sangat singkat. Itulah bedanya dengan pembangkit listrik tenag