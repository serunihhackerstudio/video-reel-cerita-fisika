[{"teks": "Di film Doctor Strange in the Multiverse of Madness, seseorang bisa masuk ke tubuh dirinya di semesta lain lewat mimpi. Apakah sains mengizinkannya?", "kata": [["Di", 0.107875, 0.24675], ["film", 0.24675, 0.466666], ["Doctor", 0.466666, 0.721291], ["Strange", 0.721291, 1.056957], ["in", 1.056958, 1.265291], ["the", 1.265291, 1.346291], ["Multiverse", 1.346291, 1.878707], ["of", 1.878708, 2.029166], ["Madness", 2.029166, 2.538416], ["seseorang", 2.769916, 3.198166], ["bisa", 3.198166, 3.371749], ["masuk", 3.37175, 3.591666], ["ke", 3.591666, 3.6379569], ["tubuh", 3.637958, 3.857874], ["dirinya", 3.857875, 4.170375], ["di", 4.170375, 4.239833], ["semesta", 4.239833, 4.563874], ["lain", 4.563875, 4.8185], ["lewat", 4.8185, 5.05], ["mimpi", 5.05, 5.536125], ["Apakah", 6.310666, 6.715749], ["sains", 6.71575, 6.981958], ["mengizinkannya", 6.981958, 7.826874]]}, {"teks": "Pertama, apakah semesta lain itu ada? Beberapa teori fisika memang mengizinkannya: cabang-cabang kenyataan menurut tafsiran banyak dunia, atau gelembung-gelembung alam semesta lain di luar jangkauan pengamatan kita.", "kata": [["Pertama", 0.098166, 0.746332], ["apakah", 1.0125, 1.336583], ["semesta", 1.336583, 1.649083], ["lain", 1.649083, 1.811124], ["itu", 1.811125, 1.984708], ["ada", 1.984708, 2.412958], ["Beberapa", 3.194458, 3.553249], ["teori", 3.55325, 3.773166], ["fisika", 3.773166, 4.120374], ["memang", 4.120375, 4.363416], ["mengizinkannya", 4.363416, 5.196749], ["cabang-cabang", 5.462958, 6.030083], ["kenyataan", 6.030083, 6.446749], ["menurut", 6.44675, 6.712958], ["tafsiran", 6.712958, 7.106458], ["banyak", 7.1065, 7.337958], ["dunia", 7.337958, 7.847208], ["atau", 8.078708, 8.333333], ["gelembung-gelembung", 8.333333, 8.923624], ["alam", 8.923625, 9.155083], ["semesta", 9.155083, 9.467583], ["lain", 9.467583, 9.733791], ["di", 9.733791, 9.803249], ["luar", 9.80325, 10.0], ["jangkauan", 10.0, 10.50925], ["pengamatan", 10.50925, 10.9375], ["kita", 10.9375, 11.388875]]}, {"teks": "Tapi semua itu masih hipotesis. Sampai sekarang belum ada satu pun bukti pengamatan bahwa semesta lain benar-benar ada.", "kata": [["Tapi", 0.098166, 0.352791], ["semua", 0.352791, 0.595832], ["itu", 0.595833, 0.815749], ["masih", 0.81575, 1.070375], ["hipotesis", 1.070375, 1.787958], ["Sampai", 2.559708, 2.872208], ["sekarang", 2.872208, 3.230999], ["belum", 3.231, 3.381458], ["ada", 3.3815, 3.5435], ["satu", 3.5435, 3.751833], ["pun", 3.751833, 3.890708], ["bukti", 3.89075, 4.099083], ["pengamatan", 4.099083, 4.631499], ["bahwa", 4.6315, 4.886125], ["semesta", 4.886125, 5.244916], ["lain", 5.244916, 5.464832], ["benar-benar", 5.464833, 5.916208], ["ada", 5.916208, 6.356041]]}, {"teks": "Bahkan dalam teori-teori itu, semesta lain umumnya tidak bisa saling berhubungan. Cabang yang sudah terpisah tidak bisa saling dikunjungi.", "kata": [["Bahkan", 0.107875, 0.455083], ["dalam", 0.455083, 0.651833], ["teori-teori", 0.651833, 1.103208], ["itu", 1.10325, 1.5315], ["semesta", 1.844, 2.225916], ["lain", 2.225916, 2.387957], ["umumnya", 2.387958, 2.781458], ["tidak", 2.7815, 2.989833], ["bisa", 2.989833, 3.209708], ["saling", 3.209708, 3.452749], ["berhubungan", 3.452791, 4.112499], ["Cabang", 4.886125, 5.22175], ["yang", 5.22175, 5.325916], ["sudah", 5.325916, 5.534249], ["terpisah", 5.53425, 5.974083], ["tidak", 5.974083, 6.170833], ["bisa", 6.170833, 6.390749], ["saling", 6.39075, 6.633791], ["dikunjungi", 6.633791, 7.281957]]}, {"teks": "Lalu bagaimana dengan mimpi? Mimpi paling jelas terjadi saat fase tidur REM, ketika otak sangat aktif dan menyusun ulang potongan ingatan, emosi, dan pengalaman kita.", "kata": [["Lalu", 0.099083, 0.365291], ["bagaimana", 0.365291, 0.851374], ["dengan", 0.851375, 1.048125], ["mimpi", 1.048166, 1.545832], ["Mimpi", 2.326375, 2.604166], ["paling", 2.604166, 2.812499], ["jelas", 2.8125, 3.055541], ["terjadi", 3.055541, 3.460624], ["saat", 3.460666, 3.668999], ["fase", 3.669, 3.912041], ["tidur", 3.912041, 4.166666], ["REM", 4.166666, 4.548624], ["ketika", 4.80325, 5.069458], ["otak", 5.069458, 5.277791], ["sangat", 5.277791, 5.509249], ["aktif", 5.50925, 5.856458], ["dan", 5.8565, 5.983791], ["menyusun", 5.983791, 6.307874], ["ulang", 6.307875, 6.504625], ["potongan", 6.504625, 6.805541], ["ingatan", 6.805541, 7.349541], ["emosi", 7.557875, 8.182875], ["dan", 8.391208, 8.622666], ["pengalaman", 8.622666, 9.027749], ["kita", 9.027791, 9.467624]]}, {"teks": "Karena itu, dunia mimpi terasa seperti versi lain dari hidup kita: tempat yang mirip tapi berbeda, orang yang kita kenal tapi berubah. Semua bahannya berasal dari otak kita sendiri.", "kata": [["Karena", 0.107875, 0.316208], ["itu", 0.316208, 0.744458], ["dunia", 0.999083, 1.288416], ["mimpi", 1.288416, 1.519916], ["terasa", 1.519916, 1.832416], ["seperti", 1.832416, 2.098624], ["versi", 2.098625, 2.364833], ["lain", 2.364833, 2.584708], ["dari", 2.584708, 2.723583], ["hidup", 2.723625, 2.931958], ["kita", 2.931958, 3.348624], ["tempat", 3.591666, 3.892582], ["yang", 3.892583, 3.996749], ["mirip", 3.99675, 4.1935], ["tapi", 4.1935, 4.378666], ["berbeda", 4.378708, 4.980541], ["orang", 5.188875, 5.431916], ["yang", 5.431958, 5.536124], ["kita", 5.536125, 5.721291], ["kenal", 5.721291, 5.975916], ["tapi", 5.975916, 6.184249], ["berubah", 6.18425, 6.705083], ["Semua", 7.478708, 7.814333], ["bahannya", 7.814333, 8.219416], ["berasal", 8.219458, 8.612958], ["dari", 8.612958, 8.774999], ["otak", 8.775, 9.0065], ["kita", 9.0065, 9.180083], ["sendiri", 9.180083, 9.724083]]}, {"teks": "Yang nyata adalah mimpi sadar. Sebagian orang bisa sadar sedang bermimpi, dan dalam penelitian, mereka bahkan bisa memberi tanda dengan gerakan mata ke peneliti di luar.", "kata": [["Yang", 0.099083, 0.318999], ["nyata", 0.319, 0.608333], ["adalah", 0.608333, 0.909249], ["mimpi", 0.90925, 1.14075], ["sadar", 1.14075, 1.661583], ["Sebagian", 2.442125, 2.835625], ["orang", 2.835666, 3.067124], ["bisa", 3.067125, 3.252291], ["sadar", 3.252333, 3.518499], ["sedang", 3.5185, 3.738416], ["bermimpi", 3.738416, 4.293957], ["dan", 4.537041, 4.756957], ["dalam", 4.756958, 4.930541], ["penelitian", 4.930541, 5.578707], ["mereka", 5.8565, 6.111125], ["bahkan", 6.111125, 6.388875], ["bisa", 6.388875, 6.5625], ["memberi", 6.5625, 6.770833], ["tanda", 6.770833, 7.060166], ["dengan", 7.060166, 7.280082], ["gerakan", 7.280083, 7.557874], ["mata", 7.557875, 7.824083], ["ke", 7.824083, 7.893499], ["peneliti", 7.8935, 8.252291], ["di", 8.252333, 8.344916], ["luar", 8.344916, 8.773166]]}, {"teks": "Jadi, dreamwalking ke semesta lain masih fiksi. Tapi setiap malam, otak kita memang membangun semesta kecilnya sendiri. Menurutmu, kalau semesta lain ada, versi dirimu yang mana yang ingin kamu temui?", "kata": [["Jadi", 0.098166, 0.688457], ["dreamwalking", 0.954625, 1.533333], ["ke", 1.533333, 1.591208], ["semesta", 1.591208, 1.915291], ["lain", 1.915291, 2.135166], ["masih", 2.135166, 2.366666], ["fiksi", 2.366666, 2.864332], ["Tapi", 3.645833, 3.854166], ["setiap", 3.854166, 4.143499], ["malam", 4.1435, 4.594875], ["otak", 4.861125, 5.092583], ["kita", 5.092583, 5.277749], ["memang", 5.277791, 5.486124], ["membangun", 5.486125, 5.868041], ["semesta", 5.868041, 6.215249], ["kecilnya", 6.215291, 6.574082], ["sendiri", 6.574083, 7.118083], ["Menurutmu", 7.905083, 8.541666], ["kalau", 8.796291, 8.981457], ["semesta", 8.9815, 9.317125], ["lain", 9.317125, 9.49075], ["ada", 9.49075, 9.965291], ["versi", 10.219916, 10.532416], ["dirimu", 10.532416, 10.798624], ["yang", 10.798625, 10.914333], ["mana", 10.914333, 11.111083], ["yang", 11.111125, 11.226833], ["ingin", 11.226833, 11.423583], ["kamu", 11.423625, 11.585666], ["temui", 11.585666, 12.071791]]}]