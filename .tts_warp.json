, 0.90025, 1.070125], ["batas", 1.070125, 1.337125], ["kecepatan", 1.337125, 1.798291], ["alam", 1.798291, 2.004582], ["semesta", 2.004625, 2.623541], ["Menurut", 3.446583, 3.737833], ["Einstein", 3.737875, 4.30825], ["tidak", 4.5995, 4.793666], ["ada", 4.793708, 4.951458], ["benda", 4.951458, 5.169916], ["bermassa", 5.169916, 5.594666], ["yang", 5.594666, 5.740291], ["bisa", 5.740291, 5.946582], ["mencapai", 5.946583, 6.322791], ["kecepatan", 6.322833, 6.747583], ["cahaya", 6.747583, 7.342249], ["sekitar", 7.584958, 7.985416], ["tiga", 7.985416, 8.215999], ["ratus", 8.216, 8.470875], ["ribu", 8.470875, 8.689333], ["kilometer", 8.689333, 9.101958], ["per", 9.101958, 9.223291], ["detik", 9.223291, 9.623791], ["Semakin", 10.449041, 10.837374], ["cepat", 10.837375, 11.067958], ["sebuah", 11.067958, 11.347083], ["pesawat", 11.347083, 11.674749], ["melaju", 11.67475, 12.220875], ["semakin", 12.5, 12.876208], ["besar", 12.876208, 13.106791], ["energi", 13.106791, 13.470874], ["yang", 13.470875, 13.580083], ["dibutuhkan", 13.580083, 14.114083], ["untuk", 14.114083, 14.368916], ["mempercepatnya", 14.368916, 14.963582], ["lagi", 14.963583, 15.424749], ["Untuk", 16.25, 16.492708], ["mencapai", 16.492708, 16.868916], ["kecepatan", 16.868916, 17.305791], ["cahaya", 17.305833, 17.900499], ["energinya", 18.19175, 18.713583], ["menjadi", 18.713583, 19.089791], ["tak", 19.089791, 19.271832], ["terhingga", 19.271833, 19.915041], ["Jadi", 20.728875, 21.347791], ["berpacu", 21.626958, 22.039583], ["dengan", 22.039583, 22.245874], ["cahaya", 22.245875, 22.622083], ["adalah", 22.622083, 22.889083], ["perlombaan", 22.889083, 23.350249], ["yang", 23.35025, 23.495875], ["pasti", 23.495875, 23.799291], ["kalah", 23.799291, 24.284707]]}, {"teks": "Tapi ada celah dalam aturan itu. Ruang dan waktu sendiri bisa melengkung dan mengembang. Buktinya, alam semesta terus mengembang sejak Big Bang, dan galaksi yang sangat jauh menjauh dari kita lebih cepat daripada cahaya. Tidak ada aturan yang dilanggar, sebab batas kecepatan cahaya berlaku untuk benda di dalam ruang, bukan untuk ruangnya sendiri.", "kata": [["Tapi", 0.099291, 0.414791], ["ada", 0.414791, 0.596832], ["celah", 0.596833, 0.875958], ["dalam", 0.875958, 1.094416], ["aturan", 1.094416, 1.385666], ["itu", 1.385666, 1.834707], ["Ruang", 2.647083, 2.999041], ["dan", 2.999041, 3.144666], ["waktu", 3.144666, 3.387374], ["sendiri", 3.387375, 3.8], ["bisa", 3.8, 4.030583], ["melengkung", 4.030583, 4.443208], ["dan", 4.443208, 4.588833], ["mengembang", 4.588833, 5.195624], ["Buktinya", 6.008, 6.724], ["alam", 7.015291, 7.221582], ["semesta", 7.221583, 7.585666], ["terus", 7.585666, 7.828374], ["mengembang", 7.828416, 8.180332], ["sejak", 8.180333, 8.495874], ["Big", 8.495875, 8.665791], ["Bang", 8.665791, 9.041999], ["dan", 9.321125, 9.527416], ["galaksi", 9.527416, 9.879374], ["yang", 9.879375, 9.976458], ["sangat", 9.976458, 10.231291], ["jauh", 10.231291, 10.449749], ["menjauh", 10.44975, 10.862375], ["dari", 10.862375, 11.008], ["kita", 11.008, 11.202166], ["lebih", 11.202166, 11.384207], ["cepat", 11.384208, 11.675458], ["daripada", 11.6755, 12.039583], ["cahaya", 12.039583, 12.622124], ["Tidak", 13.446583, 13.628624], ["ada", 13.628625, 13.77425], ["aturan", 13.774291, 14.065541], ["yang", 14.065541, 14.174749], ["dilanggar", 14.17475, 14.769416], ["sebab", 15.048541, 15.327666], ["batas", 15.327666, 15.594666], ["kecepatan", 15.594666, 16.007291], ["cahaya", 16.007291, 16.322832], ["berlaku", 16.322833, 16.747583], ["untuk", 16.747583, 16.953874], ["benda", 16.953875, 17.233], ["di", 17.233, 17.317958], ["dalam", 17.317958, 17.548541], ["ruang", 17.548541, 17.985416], ["bukan", 18.228166, 18.531541], ["untuk", 18.531541, 18.749999], ["ruangnya", 18.75, 19.029125], ["sendiri", 19.029125, 19.587375]]}, {"teks": "Tahun seribu sembilan ratus sembilan puluh empat, fisikawan Miguel Alcubierre mengusulkan ide berani. Bayangkan sebuah pesawat di dalam gelembung warp. Ruang di depan gelembung menyusut, sementara ruang di belakangnya mengembang. Gelembung itu meluncur seperti peselancar di atas gelombang ruang-waktu. Pesawatnya sendiri diam di dalam gelembung, jadi aturan Einstein tetap aman. Dan para penumpang tidak merasakan percepatan sama sekali. Kalau gelembungnya cukup cepat, perjalanan ke Proxima Centauri bisa ditempuh dalam hitungan minggu, bukan puluhan ribu tahun.", "kata": [["Tahun", 0.110666, 0.353374], ["seribu", 0.353416, 0.644666], ["sembilan", 0.644666, 0.948041], ["ratus", 0.948041, 1.166499], ["sembilan", 1.1665, 1.445625], ["puluh", 1.445625, 1.603375], ["empat", 1.603416, 2.040291], ["fisikawan", 2.319416, 2.816999], ["Miguel", 2.817, 3.10825], ["Alcubierre", 3.10825, 3.727166], ["mengusulkan", 3.727166, 4.248999], ["ide", 4.249041, 4.528166], ["berani", 4.528166, 5.062166], ["Bayangkan", 5.8745, 6.396333], ["sebuah", 6.396375, 6.69975], ["pesawat", 6.69975, 7.136625], ["di", 7.136666, 7.233749], ["dalam", 7.23375, 7.488583], ["gelembung", 7.488583, 7.816249], ["warp", 7.81625, 8.204583], ["Ruang", 9.017708, 9.296833], ["di", 9.296833, 9.357499], ["depan", 9.357541, 9.612374], ["gelembung", 9.612375, 9.903625], ["menyusut", 9.903625, 10.474], ["sementara", 10.741, 11.153625], ["ruang", 11.153625, 11.420625], ["di", 11.420625, 11.493458], ["belakangnya", 11.493458, 11.954624], ["mengembang", 11.954625, 12.561416], ["Gelembung", 13.3745, 13.726458], ["itu", 13.726458, 13.969166], ["meluncur", 13.969166, 14.369666], ["seperti", 14.369666, 14.660916], ["peselancar", 14.660916, 15.219166], ["di", 15.219166, 15.328374], ["atas", 15.328416, 15.571124], ["gelombang", 15.571125, 15.947333], ["ruang-waktu", 15.947333, 16.663333], ["Pesawatnya", 17.487875, 17.936875], ["sendiri", 17.936875, 18.300958], ["diam", 18.300958, 18.543666], ["di", 18.543708, 18.616499], ["dalam", 18.6165, 18.834958], ["gelembung", 18.834958, 19.368958], ["jadi", 19.672333, 19.951458], ["aturan", 19.951458, 20.230583], ["Einstein", 20.230583, 20.655333], ["tetap", 20.655333, 20.898041], ["aman", 20.898041, 21.395624], ["Dan", 22.209458, 22.464333], ["para", 22.464333, 22.622083], ["penumpang", 22.622083, 23.083249], ["tidak", 23.08325, 23.277416], ["merasakan", 23.277416, 23.726457], ["percepatan", 23.726458, 24.236166], ["sama", 24.236166, 24.466749], ["sekali", 24.46675, 25.037125], ["Kalau", 25.861666, 26.080082], ["gelembungnya", 26.080083, 26.553374], ["cukup", 26.553416, 26.796124], ["cepat", 26.796125, 27.245166], ["perjalanan", 27.512125, 28.021833], ["ke", 28.021833, 28.094666], ["Proxima", 28.094666, 28.446582], ["Centauri", 28.446583, 28.895624], ["bisa", 28.895625, 29.114083], ["ditempuh", 29.114083, 29.502416], ["dalam", 29.502416, 29.708707], ["hitungan", 29.70875, 30.024291], ["minggu", 30.024291, 30.509707], ["bukan", 30.752416, 31.080082], ["puluhan", 31.080083, 31.419874], ["ribu", 31.419916, 31.614082], ["tahun", 31.614083, 32.135916]]}, {"teks": "Sayangnya, ada hambatan besar. Gelembung warp membutuhkan energi negatif, atau materi eksotis, yang belum pernah ditemukan dalam jumlah berarti. Perhitungan awal menyebut energinya melampaui seluruh massa alam semesta teramati. Setelah disempurnakan, kebutuhannya turun menjadi setara massa planet raksasa seperti Jupiter. Tetap saja, mustahil untuk sekarang. Belum lagi, kita belum tahu cara mengendalikan gelembung itu, dan saat berhenti, ia bisa melepaskan ledakan radiasi berbahaya.", "kata": [["Sayangnya", 0.099291, 0.875999], ["ada", 1.130833, 1.373541], ["hambatan", 1.373541, 1.749749], ["besar", 1.74975, 2.247333], ["Gelembung", 3.059, 3.435208], ["warp", 3.435208, 3.653624], ["membutuhkan", 3.653625, 4.0905], ["energi", 4.090541, 4.418207], ["negatif", 4.418208, 5.049291], ["atau", 5.304125, 5.571125], ["materi", 5.571125, 5.8745], ["eksotis", 5.8745, 6.529833], ["yang", 6.772583, 6.942458], ["belum", 6.942458, 7.100208], ["pernah", 7.10025, 7.342958], ["ditemukan", 7.342958, 7.791999], ["dalam", 7.792, 8.010416], ["jumlah", 8.010416, 8.289541], ["berarti", 8.289583, 8.872124], ["