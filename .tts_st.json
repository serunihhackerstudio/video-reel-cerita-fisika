4916, 5.546916], ["waktu", 5.872416, 6.210957], ["bagi", 6.210958, 6.406249], ["astronot", 6.40625, 6.848958], ["di", 6.848958, 6.927083], ["dalamnya", 6.927083, 7.382833], ["berjalan", 7.382833, 7.838541], ["sedikit", 7.838541, 8.216166], ["lebih", 8.216166, 8.424499], ["lambat", 8.4245, 8.789083], ["daripada", 8.789083, 9.231791], ["di", 9.231791, 9.322916], ["Bumi", 9.322916, 9.804707]]}, {"teks": "Selisihnya sangat kecil. Setelah berbulan-bulan di orbit, astronot pulang hanya sepersekian detik lebih muda dibanding jika tetap di Bumi.", "kata": [["Selisihnya", 0.100541, 0.803666], ["sangat", 0.803666, 1.090124], ["kecil", 1.090125, 1.637], ["Setelah", 2.526041, 2.864582], ["berbulan-bulan", 2.864583, 3.424499], ["di", 3.4245, 3.489583], ["orbit", 3.489583, 4.049499], ["astronot", 4.348958, 4.778666], ["pulang", 4.778666, 5.091166], ["hanya", 5.091166, 5.299499], ["sepersekian", 5.2995, 5.833333], ["detik", 5.833333, 6.106791], ["lebih", 6.106791, 6.289082], ["muda", 6.289083, 6.510416], ["dibanding", 6.510416, 7.057291], ["jika", 7.057291, 7.304707], ["tetap", 7.304708, 7.604166], ["di", 7.604166, 7.695332], ["Bumi", 7.695333, 8.164083]]}, {"teks": "Artinya, saat pulang, astronot itu sebenarnya sudah melompat sedikit ke masa depan.", "kata": [["Artinya", 0.115125, 0.80525], ["saat", 1.078666, 1.352082], ["pulang", 1.352083, 1.833874], ["astronot", 2.146375, 2.589083], ["itu", 2.589083, 2.797416], ["sebenarnya", 2.797416, 3.292207], ["sudah", 3.292208, 3.539583], ["melompat", 3.539583, 3.865124], ["sedikit", 3.865125, 4.281791], ["ke", 4.281791, 4.359916], ["masa", 4.359916, 4.594291], ["depan", 4.594291, 5.102124]]}, {"teks": "Ini bukan teori kosong. Pada tahun seribu sembilan ratus tujuh puluh satu, jam atom yang dibawa terbang mengelilingi dunia dengan pesawat terbukti menunjukkan selisih waktu sesuai prediksi relativitas.", "kata": [["Ini", 0.100541, 0.413041], ["bukan", 0.413041, 0.712499], ["teori", 0.7125, 0.959916], ["kosong", 0.959916, 1.558874], ["Pada",