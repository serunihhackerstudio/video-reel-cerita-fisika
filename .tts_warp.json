, 3.19175], ["para", 3.19175, 3.32525], ["fisikawan", 3.32525, 3.834958], ["masih", 3.834958, 4.077666], ["menelaah", 4.077666, 4.417457], ["ide", 4.417458, 4.599499], ["ini", 4.5995, 5.02425], ["dan", 5.315541, 5.509707], ["usulan", 5.509708, 5.837374], ["teori", 5.837375, 6.043666], ["terbaru", 6.043708, 6.395624], ["mencoba", 6.395625, 6.771833], ["memangkas", 6.771833, 7.148041], ["kebutuhan", 7.148041, 7.548541], ["energinya", 7.548541, 8.264541], ["bahkan", 8.531541, 8.932041], ["tanpa", 8.932041, 9.186874], ["energi", 9.186875, 9.514541], ["negatif", 9.514583, 10.169916], ["Belum", 10.984458, 11.275708], ["ada", 11.275708, 11.530583], ["yang", 11.530583, 11.664083], ["berhasil", 11.664083, 12.064583], ["membangunnya", 12.064583, 12.780583], ["Tapi", 13.604375, 13.822833], ["suatu", 13.822833, 14.077666], ["hari", 14.077666, 14.235416], ["nanti", 14.235416, 14.757249], ["mungkin", 15.048541, 15.376207], ["kita", 15.376208, 15.546124], ["akan", 15.546125, 15.716], ["menatap", 15.716, 16.031541], ["bintang", 16.031541, 16.286416], ["itu", 16.286416, 16.504874], ["dari", 16.504875, 16.686875], ["dekat", 16.686875, 17.087375], ["Mungkin", 17.901958, 18.302416], ["suatu", 18.302416, 18.557291], ["hari", 18.557291, 18.727166], ["nanti", 18.727166, 19.248999]]}]