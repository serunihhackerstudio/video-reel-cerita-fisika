[{"teks": "Bayangkan dua saudara kembar. Satu pergi ke luar angkasa, sementara satu lagi tetap tinggal di Bumi.", "kata": [["Bayangkan", 0.100791, 0.725791], ["dua", 0.725791, 0.925249], ["saudara", 0.92525, 1.3375], ["kembar", 1.3375, 1.909291], ["Satu", 2.819166, 3.098416], ["pergi", 3.098416, 3.404249], ["ke", 3.40425, 3.497333], ["luar", 3.497333, 3.683499], ["angkasa", 3.6835, 4.375], ["sementara", 4.680833, 5.172874], ["satu", 5.172875, 5.438833], ["lagi", 5.438833, 5.757958], ["tetap", 5.757958, 6.037208], ["tinggal", 6.03725, 6.356375], ["di", 6.356375, 6.436166], ["Bumi", 6.436166, 6.914874]]}, {"teks": "Si kembar astronaut melaju dengan roket di sembilan puluh sembilan persen kecepatan cahaya, lalu berbalik pulang.", "kata": [["Si", 0.1165, 0.276083], ["kembar", 0.276083, 0.542041], ["astronaut", 0.542041, 1.073916], ["melaju", 1.073916, 1.459541], ["dengan", 1.459583, 1.698916], ["roket", 1.698916, 2.018082], ["di", 2.018083, 2.097874], ["sembilan", 2.097875, 2.417041], ["puluh", 2.417041, 2.603207], ["sembilan", 2.603208, 2.922333], ["persen", 2.922333, 3.268083], ["kecepatan", 3.268083, 3.706916], ["cahaya", 3.706916, 4.371791], ["lalu", 4.664375, 5.010125], ["berbalik", 5.010125, 5.409041], ["pulang", 5.409041, 5.927666]]}, {"teks": "Baginya, perjalanan itu terasa sepuluh tahun. Tapi saat mendarat, di Bumi sudah berlalu sekitar tujuh puluh tahun.", "kata": [["Baginya", 0.101583, 0.886166], ["perjalanan", 1.205333, 1.710624], ["itu", 1.710625, 1.95], ["terasa", 1.95, 2.29575], ["sepuluh", 2.29575, 2.6415], ["tahun", 2.6415, 3.2], ["Tapi", 4.109041, 4.374999], ["saat", 4.375, 4.614375], ["mendarat", 4.614375, 5.212791], ["di", 5.505333, 5.638291], ["Bumi", 5.638291, 5.877666], ["sudah", 5.877666, 6.130332], ["berlalu", 6.130333, 6.542541], ["sekitar", 6.542541, 6.941457], ["tujuh", 6.9415, 7.260625], ["puluh", 7.260625, 7.460083], ["tahun", 7.460125, 8.018625]]}, {"teks": "Ia pulang sebagai orang paruh baya, sementara saudara kembarnya sudah sangat tua.", "kata": [["Ia", 0.1165, 0.276083], ["pulang", 0.276083, 0.568624], ["sebagai", 0.568625, 0.914375], ["orang", 0.914375, 1.127125], ["paruh", 1.127125, 1.353208], ["baya", 1.353208, 1.924999], ["sementara", 2.230833, 2.722874], ["saudara", 2.722875, 3.095208], ["kembarnya", 3.095208, 3.547333], ["sudah", 3.547333, 3.839874], ["sangat", 3.839875, 4.132416], ["tua", 4.132458, 4.557999]]}, {"teks": "Kenapa disebut paradoks? Dari sudut pandang roket, Bumi-lah yang bergerak. Jawabannya, hanya si kembar astronaut yang mempercepat, berbalik, dan melambat. Jadi perjalanan mereka tidak setara.", "kata": [["Kenapa", 0.100791, 0.526332], ["disebut", 0.526333, 0.885374], ["paradoks", 0.885375, 1.643333], ["Dari", 2.538291, 2.804249], ["sudut", 2.80425, 3.110083], ["pandang", 3.110125, 3.402666], ["roket", 3.402666, 3.934582], ["Bumi-lah", 4.18725, 4.665958], ["yang", 4.665958, 4.812249], ["bergerak", 4.81225, 5.397375], ["Jawabannya", 6.303208, 7.207458], ["hanya", 7.5, 7.77925], ["si", 7.77925, 7.912208], ["kembar", 7.91225, 8.164875], ["astronaut", 8.164875, 8.696791], ["yang", 8.696791, 8.816457], ["mempercepat", 8.8165, 9.521291], ["berbalik", 9.78725, 10.452125], ["dan", 10.651583, 10.917541], ["melambat", 10.917541, 11.555832], ["Jadi", 12.445208, 12.830833], ["perjalanan", 12.830833, 13.349458], ["mereka", 13.349458, 13.681916], ["tidak", 13.681916, 13.961166], ["setara", 13.961166, 14.559582]]}, {"teks": "Efek ini terbukti di alam. Partikel muon yang terbentuk di atmosfer seharusnya meluruh sebelum sampai ke tanah. Tapi karena melaju sangat cepat, waktunya melambat dan banyak yang sampai.", "kata": [["Efek", 0.101583, 0.420749], ["ini", 0.42075, 0.7], ["terbukti", 0.7, 1.192041], ["di", 1.192041, 1.285124], ["alam", 1.285125, 1.817041], ["Partikel", 2.711166, 3.149999], ["muon", 3.15, 3.402666], ["yang", 3.402666, 3.535624], ["terbentuk", 3.535625, 3.907958], ["di", 3.907958, 3.987749], ["atmosfer", 3.98775, 4.54625], ["seharusnya", 4.546291, 5.078207], ["meluruh", 5.078208, 5.463833], ["sebelum", 5.463833, 5.822874], ["sampai", 5.822875, 6.168625], ["ke", 6.168625, 6.248416], ["tanah", 6.248416, 6.780332], ["Tapi", 7.686166, 8.005332], ["karena", 8.005333, 8.271291], ["melaju", 8.271291, 8.590416], ["sangat", 8.590416, 8.856374], ["cepat", 8.856375, 9.361708], ["waktunya", 9.65425, 10.053166], ["melambat", 10.053208, 10.492041], ["dan", 10.492041, 10.678207], ["banyak", 10.678208, 11.010624], ["yang", 11.010625, 11.143583], ["sampai", 11.143625, 11.795208]]}, {"teks": "Ternyata, bukan cuma kecepatan yang bisa memperlambat waktu.", "kata": [["Ternyata", 0.101583, 0.872874], ["bukan", 1.178708, 1.511166], ["cuma", 1.511166, 1.710624], ["kecepatan", 1.710625, 2.215958], ["yang", 2.215958, 2.375541], ["bisa", 2.375541, 2.654791], ["memperlambat", 2.654791, 3.226582], ["waktu", 3.226583, 3.811708]]}]