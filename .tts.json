[{"teks": "Emas di cincinmu tidak terbentuk di Bumi. Atom-atomnya jauh lebih tua, bahkan lebih tua dari Bumi itu sendiri. Mari kita telusuri asalnya.", "kata": [["Emas", 0.099291, 0.429499], ["di", 0.4295, 0.512041], ["cincinmu", 0.512041, 0.971916], ["tidak", 0.971916, 1.195957], ["terbentuk", 1.196, 1.561541], ["di", 1.561541, 1.644082], ["Bumi", 1.644083, 2.092208], ["Atom-atomnya", 2.878791, 3.527374], ["jauh", 3.527375, 3.798583], ["lebih", 3.798583, 3.987249], ["tua", 3.98725, 4.4], ["bahkan", 4.659416, 5.001416], ["lebih", 5.001416, 5.178291], ["tua", 5.178291, 5.378749], ["dari", 5.378791, 5.543874], ["Bumi", 5.543875, 5.732541], ["itu", 5.732541, 5.897624], ["sendiri", 5.897625, 6.440083], ["Mari", 7.231583, 7.549999], ["kita", 7.55, 7.76225], ["telusuri", 7.76225, 8.139625], ["asalnya", 8.139625, 8.776416]]}, {"teks": "Bintang biasa hanya bisa membuat unsur sampai sekitar besi. Untuk emas, dibutuhkan proses yang jauh lebih ekstrem.", "kata": [["Bintang", 0.098583, 0.499541], ["biasa", 0.499541, 0.817916], ["hanya", 0.817916, 1.018374], ["bisa", 1.018416, 1.230666], ["membuat", 1.230666, 1.513666], ["unsur", 1.513666, 1.867457], ["sampai", 1.867458, 2.185833], ["sekitar", 2.185833, 2.516041], ["besi", 2.516041, 2.964166], ["Untuk", 3.761791, 3.985832], ["emas", 3.985833, 4.433958], ["dibutuhkan", 4.646208, 5.153291], ["proses", 5.153291, 5.507082], ["yang", 5.507083, 5.648583], ["jauh", 5.648583, 5.919791], ["lebih", 5.919791, 6.096666], ["ekstrem", 6.096708, 6.650958]]}, {"teks": "Unsur berat terbentuk saat inti atom dihujani neutron dengan sangat cepat, sampai membesar menjadi unsur seperti emas dan platina.", "kata": [["Unsur", 0.108958, 0.380166], ["berat", 0.380208, 0.580666], ["terbentuk", 0.580666, 0.957999], ["saat", 0.958, 1.17025], ["inti", 1.170291, 1.347166], ["atom", 1.347166, 1.618374], ["dihujani", 1.618416, 2.007541], ["neutron", 2.007541, 2.373124], ["dengan", 2.373125, 2.55], ["sangat", 2.55, 2.785833], ["cepat", 2.785833, 3.222166], ["sampai", 3.505208, 3.788208], ["membesar", 3.788208, 4.141999], ["menjadi", 4.142, 4.413208], ["unsur", 4.413208, 4.743416], ["seperti", 4.743416, 5.038207], ["emas", 5.038208, 5.380208], ["dan", 5.380208, 5.545291], ["platina", 5.545291, 6.111332]]}, {"teks": "Kondisi seekstrem itu hanya ada di peristiwa paling dahsyat di alam semesta. Salah satunya, yang teramati tahun dua ribu tujuh belas, adalah tabrakan dua bintang neutron.", "kata": [["Kondisi", 0.098583, 0.464166], ["seekstrem", 0.464166, 0.853291], ["itu", 0.853291, 1.148082], ["hanya", 1.148125, 1.372166], ["ada", 1.372166, 1.549041], ["di", 1.549041, 1.619791], ["peristiwa", 1.619791, 2.056124], ["paling", 2.056125, 2.280166], ["dahsyat", 2.280208, 2.657541], ["di", 2.657541, 2.751874], ["alam", 2.751875, 2.940541], ["semesta", 2.940583, 3.541999], ["Salah", 4.339625, 4.563666], ["satunya", 4.563666, 5.165082], ["yang", 5.41275, 5.613208], ["teramati", 5.613208, 5.990583], ["tahun", 5.990583, 6.261791], ["dua", 6.261791, 6.391499], ["ribu", 6.3915, 6.533], ["tujuh", 6.533, 6.780625], ["belas", 6.780666, 7.193416], ["adalah", 7.441041, 7.735832], ["tabrakan", 7.735833, 8.160374], ["dua", 8.160375, 8.325458], ["bintang", 8.325458, 8.632041], ["neutron", 8.632083, 9.174541]]}, {"teks": "Dua bola sangat padat itu saling mengorbit makin cepat, bertabrakan, lalu menyemburkan awan bercahaya penuh partikel emas.", "kata": [["Dua", 0.108958, 0.297624], ["bola", 0.297625, 0.462708], ["sangat", 0.46275, 0.733958], ["padat", 0.733958, 0.934416], ["itu", 0.934416, 1.170249], ["saling", 1.170291, 1.429707], ["mengorbit", 1.429708, 1.818874], ["makin", 1.818875, 2.054708], ["cepat", 2.054708, 2.467458], ["bertabrakan", 2.715083, 3.469791], ["lalu", 3.764625, 3.988666], ["menyemburkan", 3.988666, 4.460374], ["awan", 4.460375, 4.708], ["bercahaya", 4.708, 5.1915], ["penuh", 5.1915, 5.427333], ["partikel", 5.427375, 5.8165], ["emas", 5.8165, 6.3]]}, {"teks": "Awan itu menyebar, dan bercampur ke dalam awan gas yang kelak membentuk tata surya kita.", "kata": [["Awan", 0.108958, 0.297624], ["itu", 0.297625, 0.462708], ["menyebar", 0.46275, 1.017], ["dan", 1.276416, 1.476874], ["bercampur", 1.476875, 1.913208], ["ke", 1.913208, 1.983958], ["dalam", 1.983958, 2.172624], ["awan", 2.172625, 2.408458], ["gas", 2.4085, 2.644333], ["yang", 2.644333, 2.762249], ["kelak", 2.76225, 2.986291], ["membentuk", 2.986333, 3.328291], ["tata", 3.328291, 3.552332], ["surya", 3.552375, 3.835375], ["kita", 3.835375, 4.295291]]}, {"teks": "Sebagian besar emas Bumi tenggelam ke inti saat Bumi masih cair. Emas yang kita tambang sekarang diduga dibawa hujan asteroid setelahnya.", "kata": [["Sebagian", 0.098583, 0.534916], ["besar", 0.534916, 0.770749], ["emas", 0.77075, 0.994791], ["Bumi", 0.994791, 1.230624], ["tenggelam", 1.230666, 1.560832], ["ke", 1.560833, 1.619791], ["inti", 1.619791, 1.949999], ["saat", 1.95, 2.185833], ["Bumi", 2.185833, 2.433458], ["masih", 2.4335, 2.704708], ["cair", 2.704708, 3.188208], ["Emas", 3.975458, 4.282041], ["yang", 4.282083, 4.376416], ["kita", 4.376416, 4.553291], ["tambang", 4.553291, 4.812707], ["sekarang", 4.81275, 5.201875], ["diduga", 5.201875, 5.520291], ["dibawa", 5.520291, 5.838666], ["hujan", 5.838666, 6.121666], ["asteroid", 6.121708, 6.581583], ["setelahnya", 6.581583, 7.230166]]}, {"teks": "Jadi, setiap gram emas adalah sisa peristiwa kosmik, jauh sebelum Bumi lahir.", "kata": [["Jadi", 0.108958, 0.686791], ["setiap", 0.934416, 1.264624], ["gram", 1.264625, 1.4415], ["emas", 1.4415, 1.7245], ["adalah", 1.724541, 1.983957], ["sisa", 1.983958, 2.231583], ["peristiwa", 2.231583, 2.608958], ["kosmik", 2.608958, 3.116041], ["jauh", 3.375458, 3.705666], ["sebelum", 3.705666, 3.988666], ["Bumi", 3.988666, 4.153749], ["lahir", 4.153791, 4.637291]]}]