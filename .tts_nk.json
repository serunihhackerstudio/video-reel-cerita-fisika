[{"teks": "Sebuah benda sebesar bola softball bisa melepaskan energi puluhan ribu ton TNT. Dari mana energi sebesar itu?", "kata": [["Sebuah", 0.101333, 0.496041], ["benda", 0.496041, 0.746041], ["sebesar", 0.746041, 1.127624], ["bola", 1.127625, 1.311833], ["softball", 1.311833, 1.877624], ["bisa", 1.877625, 2.127625], ["melepaskan", 2.127625, 2.653958], ["energi", 2.653958, 3.074999], ["puluhan", 3.075, 3.482875], ["ribu", 3.482875, 3.732875], ["ton", 3.732875, 3.93025], ["TNT", 3.93025, 4.522375], ["Dari", 5.405916, 5.708541], ["mana", 5.708541, 5.932207], ["energi", 5.93225, 6.326958], ["sebesar", 6.326958, 6.721708], ["itu", 6.721708, 7.208541]]}, {"teks": "Ledakan biasa, seperti TNT, adalah reaksi kimia. Ia hanya mengatur ulang ikatan antaratom, dan melepaskan sedikit energi dari setiap ikatan. Bom nuklir bekerja dengan cara yang berbeda. Ia mengubah inti atom itu sendiri. Satu kilogram TNT melepaskan sekitar empat juta joule. Sementara satu kilogram uranium, jika semuanya terbelah, melepaskan sekitar delapan puluh triliun joule. Kira-kira dua puluh juta kali lipat.", "kata": [["Ledakan", 0.115791, 0.523666], ["biasa", 0.523666, 1.155249], ["seperti", 1.431583, 1.826333], ["TNT", 1.826333, 2.457916], ["adalah", 2.734208, 3.089458], ["reaksi", 3.089458, 3.444708], ["kimia", 3.44475, 4.036875], ["Ia", 4.934208, 5.118416], ["hanya", 5.118416, 5.355249], ["mengatur", 5.35525, 5.684208], ["ulang", 5.684208, 5.907874], ["ikatan", 5.907875, 6.236833], ["antaratom", 6.236833, 6.947374], ["dan", 7.276333, 7.486833], ["melepaskan", 7.486833, 7.986833], ["sedikit", 7.986833, 8.342083], ["energi", 8.342125, 8.815791], ["dari", 8.815791, 9.013166], ["setiap", 9.013166, 9.328957], ["ikatan", 9.328958, 9.986833], ["Bom", 10.867125, 11.143416], ["nuklir", 11.143416, 11.485541], ["bekerja", 11.485541, 11.972374], ["dengan", 11.972375, 12.248666], ["cara", 12.248666, 12.511832], ["yang", 12.511833, 12.669708], ["berbeda", 12.66975, 13.3145], ["Ia", 14.196041, 14.446041], ["meng