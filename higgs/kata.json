5.723, 35.963], ["tinggi,", 35.963, 36.42], ["hampir", 36.625, 36.985], ["secepat", 36.985, 37.334], ["cahaya.", 37.334, 37.899], ["Pada", 38.409, 38.613], ["tahun", 38.613, 38.865], ["dua", 38.865, 38.986], ["ribu", 38.986, 39.142], ["dua", 39.142, 39.286], ["belas,", 39.286, 39.755], ["boson", 39.995, 40.32], ["Higgs", 40.32, 40.608], ["akhirnya", 40.608, 41.029], ["ditemukan.", 41.029, 41.678], ["Ini", 42.482, 42.735], ["menguatkan", 42.735, 43.227], ["Model", 43.227, 43.516], ["Standar", 43.516, 43.888], ["fisika.", 43.889, 44.502], ["Penelitian", 45.307, 45.8], ["pun", 45.8, 45.944], ["berlanjut,", 45.944, 46.581], ["mencari", 46.833, 47.218], ["fisika", 47.218, 47.578], ["baru.", 47.578, 48.023]], "vo": [{"src": "assets/audio/vo-01.mp3", "at": 0.3, "teks": "Orang menyebutnya partikel Tuhan. Padahal itu cuma julukan populer. Nama ilmiahnya: boson Higgs."}, {"src": "assets/audio/vo-02.mp3", "at": 8.12, "teks": "Menurut fisika, seluruh alam semesta terisi medan yang tak terlihat. Namanya medan Higgs."}, {"src": "assets/audio/vo-03.mp3", "at": 14.34, "teks": "Partikel dasar, seperti elektron, mendapat massa lewat interaksi dengan medan ini. Tanpa itu, atom tidak bisa terbentuk. Bintang, planet, dan kita pun tidak akan ada."}, {"src": "assets/audio/vo-04.mp3", "at": 26.37, "teks": "Boson Higgs adalah riak kecil dari medan itu. Untuk membuktikannya, akselerator LHC, cincin sepanjang dua puluh tujuh kilometer, menabrakkan proton berenergi sangat tinggi, hampir secepat cahaya."}, {"src": "assets/audio/vo-05.mp3", "at": 38.3, "teks": "Pada tahun dua ribu dua belas, boson Higgs akhirnya ditemukan. Ini menguatkan Model Standar fisika. Penelitian pun berlanjut, mencari fisika baru."}]}