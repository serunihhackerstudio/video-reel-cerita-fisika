[{"teks": "Orang menyebutnya partikel Tuhan. Padahal itu cuma julukan populer. Nama ilmiahnya: boson Higgs.", "kata": [["Orang", 0.0995, 0.375958], ["menyebutnya", 0.375958, 0.904791], ["partikel", 0.904791, 1.361541], ["Tuhan", 1.361541, 1.890374], ["Padahal", 2.69325, 3.041791], ["itu", 3.041833, 3.294249], ["cuma", 3.29425, 3.522583], ["julukan", 3.522583, 3.895166], ["populer", 3.895208, 4.484166], ["Nama", 5.289916, 5.566332], ["ilmiahnya", 5.566333, 6.323541], ["boson", 6.563958, 6.960583], ["Higgs", 6.960583, 7.417333]]}, {"teks": "Menurut fisika, seluruh alam semesta terisi medan yang tak terlihat. Namanya medan Higgs.", "kata": [["Menurut", 0.110083, 0.410583], ["fisika", 0.410583, 1.023583], ["seluruh", 1.288, 1.6245], ["alam", 1.6245, 1.828833], ["semesta", 1.828833, 2.201416], ["terisi", 2.201458, 2.453833], ["medan", 2.453833, 2.778333], ["yang", 2.778375, 2.946625], ["tak", 2.946625, 3.102875], ["terlihat", 3.102875, 3.715875], ["Namanya", 4.521166, 5.037999], ["medan", 5.038, 5.3505], ["Higgs", 5.3505, 5.81925]]}, {"teks": "Partikel dasar, seperti elektron, mendapat massa lewat interaksi dengan medan ini. Tanpa itu, atom tidak bisa terbentuk. Bintang, planet, dan kita pun tidak akan ada.", "kata": [["Partikel", 0.110083, 0.494708], ["dasar", 0.494708, 1.023541], ["seperti", 1.263958, 1.612499], ["elektron", 1.6125, 2.141333], ["mendapat", 2.441833, 2.802416], ["massa", 2.802416, 3.066832], ["lewat", 3.066833, 3.295208], ["interaksi", 3.295208, 3.751916], ["dengan", 3.751916, 3.980291], ["medan", 3.980291, 4.208666], ["ini", 4.208666, 4.629332], ["Tanpa", 5.433666, 5.686041], ["itu", 5.686041, 6.166791], ["atom", 6.455291, 6.755749], ["tidak", 6.75575, 6.960083], ["bisa", 6.960083, 7.164416], ["terbentuk", 7.164416, 7.729332], ["Bintang", 8.534625, 9.183666], ["planet", 9.436041, 9.964874], ["dan", 10.205291, 10.421624], ["kita", 10.421625, 10.625958], ["pun", 10.625958, 10.818249], ["tidak", 10.81825, 11.010541], ["akan", 11.010583, 11.190874], ["ada", 11.190875, 11.635583]]}, {"teks": "Boson Higgs adalah riak kecil dari medan itu. Untuk membuktikannya, akselerator LHC, cincin sepanjang dua puluh tujuh kilometer, menabrakkan proton berenergi sangat tinggi, hampir secepat cahaya.", "kata": [["Boson", 0.099041, 0.447582], ["Higgs", 0.447583, 0.760083], ["adalah", 0.760083, 1.072583], ["riak", 1.072583, 1.240833], ["kecil", 1.240875, 1.541333], ["dari", 1.541333, 1.709583], ["medan", 1.709625, 1.95], ["itu", 1.95, 2.394708], ["Untuk", 3.209125, 3.4375], ["membuktikannya", 3.4375, 4.290875], ["akselerator", 4.567291, 5.096124], ["LHC", 5.096166, 5.733166], ["cincin", 5.973541, 6.322082], ["sepanjang", 6.322125, 6.778833], ["dua", 6.778833, 6.911041], ["puluh", 6.911041, 7.079291], ["tujuh", 7.079333, 7.319708], ["kilometer", 7.319708, 7.932708], ["menabrakkan", 8.173083, 8.665874], ["proton", 8.665875, 8.954333], ["berenergi", 8.954333, 9.350958], ["sangat", 9.350958, 9.591333], ["tinggi", 9.591333, 10.048083], ["hampir", 10.252416, 10.612999], ["secepat", 10.613, 10.961541], ["cahaya", 10.961541, 11.526457]]}, {"teks": "Pada tahun dua ribu dua belas, boson Higgs akhirnya ditemukan. Ini menguatkan Model Standar fisika. Penelitian pun berlanjut, mencari fisika baru.", "kata": [["Pada", 0.110083, 0.314416], ["tahun", 0.314416, 0.566832], ["dua", 0.566833, 0.686999], ["ribu", 0.687, 0.84325], ["dua", 0.84325, 0.9875], ["belas", 0.9875, 1.45625], ["boson", 1.696625, 2.021125], ["Higgs", 2.021166, 2.309624], ["akhirnya", 2.309625, 2.730291], ["ditemukan", 2.730291, 3.379332], ["Ini", 4.183666, 4.436041], ["menguatkan", 4.436041, 4.928832], ["Model", 4.928833, 5.217291], ["Standar", 5.217291, 5.589874], ["fisika", 5.589916, 6.202916], ["Penelitian", 7.008166, 7.500957], ["pun", 7.500958, 7.645208], ["berlanjut", 7.645208, 8.282208], ["mencari", 8.534625, 8.91925], ["fisika", 8.91925, 9.279791], ["baru", 9.279791, 9.724499]]}]