[{"teks": "Di video sebelumnya, lubang cacing adalah jembatan antar dua tempat. Ternyata, ia mungkin juga bisa menjadi jembatan antar dua waktu.", "kata": [["Di", 0.1, 0.2625], ["video", 0.2625, 0.5375], ["sebelumnya", 0.5375, 1.2875], ["lubang", 1.5875, 1.8875], ["cacing", 1.8875, 2.2375], ["adalah", 2.2375, 2.525], ["jembatan", 2.525, 2.975], ["antar", 2.975, 3.2875], ["dua", 3.2875, 3.4875], ["tempat", 3.4875, 3.95], ["Ternyata", 4.7875, 5.5], ["ia", 5.8125, 5.975], ["mungkin", 5.975, 6.275], ["juga", 6.275, 6.4875], ["bisa", 6.4875, 6.7125], ["menjadi", 6.7125, 7.025], ["jembatan", 7.025, 7.475], ["antar", 7.475, 7.7875], ["dua", 7.7875, 7.9875], ["waktu", 7.9875, 8.55]]}, {"teks": "Pada tahun 1988, fisikawan Kip Thorne dan rekannya mengusulkan caranya: andaikan ada lubang cacing yang stabil, lalu salah satu mulutnya dibawa pergi dengan kecepatan mendekati cahaya.", "kata": [["Pada", 0.1125, 0.3], ["tahun", 0.3, 0.55], ["1988", 0.55, 2.2625], ["fisikawan", 2.55, 3.0625], ["Kip", 3.0625, 3.35], ["Thorne", 3.35, 3.7375], ["dan", 3.7375, 3.9125], ["rekannya", 3.9125, 4.275], ["mengusulkan", 4.275, 4.775], ["caranya", 4.775, 5.3625], ["andaikan", 5.6375, 6.1125], ["ada", 6.1125, 6.2875], ["lubang", 6.2875, 6.55], ["cacing", 6.55, 6.8625], ["yang", 6.8625, 6.9875], ["stabil", 6.9875, 7.6], ["lalu", 7.85, 8.1], ["salah", 8.1, 8.3125], ["satu", 8.3125, 8.5], ["mulutnya", 8.5, 8.875], ["dibawa", 8.875, 9.175], ["pergi", 9.175, 9.5], ["dengan", 9.5, 9.725], ["kecepatan", 9.725, 10.1625], ["mendekati", 10.1625, 10.575], ["cahaya", 10.575, 11.1875]]}, {"teks": "Seperti paradoks kembar di episode empat, waktu di mulut yang dibawa pergi berjalan lebih lambat.", "kata": [["Seperti", 0.1125, 0.475], ["paradoks", 0.475, 0.85], ["kembar", 0.85, 1.15], ["di", 1.15, 1.2625], ["episode", 1.2625, 1.625], ["empat", 1.625, 2.1], ["waktu", 2.4, 2.7], ["di", 2.7, 2.775], ["mulut", 2.775, 3.025], ["yang", 3.025, 3.15], ["dibawa", 3.15, 3.475], ["pergi", 3.475, 3.775], ["berjalan", 3.775,