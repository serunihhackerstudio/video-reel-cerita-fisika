[{"teks": "Bagaimana dua partikel bisa saling terhubung, walau berjauhan? Mari kita bongkar eksperimennya, dari laser sampai detektor.", "kata": [["Bagaimana", 0.096541, 0.570666], ["dua", 0.570708, 0.699999], ["partikel", 0.7, 1.12025], ["bisa", 1.12025, 1.314208], ["saling", 1.314208, 1.508166], ["terhubung", 1.508208, 2.057791], ["walau", 2.284041, 2.510332], ["berjauhan", 2.510333, 3.167666], ["Mari", 3.88275, 4.119833], ["kita", 4.119833, 4.292249], ["bongkar", 4.29225, 4.529291], ["eksperimennya", 4.529291, 5.294374], ["dari", 5.520708, 5.714666], ["laser", 5.714666, 6.016374], ["sampai", 6.016375, 6.296541], ["detektor", 6.296541, 6.856874]]}, {"teks": "Dua partikel bisa dibuat berpasangan, sehingga keadaan keduanya tidak bisa dijelaskan sendiri-sendiri. Itulah entanglement kuantum.", "kata": [["Dua", 0.103875, 0.287083], ["partikel", 0.287083, 0.696541], ["bisa", 0.696541, 0.890499], ["dibuat", 0.8905, 1.159916], ["berpasangan", 1.159916, 1.817249], ["sehingga", 2.065083, 2.442249], ["keadaan", 2.44225, 2.797833], ["keduanya", 2.797833, 3.174999], ["tidak", 3.175, 3.37975], ["bisa", 3.37975, 3.59525], ["dijelaskan", 3.59525, 4.069375], ["sendiri-sendiri", 4.069416, 4.834499], ["Itulah", 5.553, 5.940916], ["entanglement", 5.940958, 6.436624], ["kuantum", 6.436625, 7.00775]]}, {"teks": "Sebuah kristal khusus membelah satu foton menjadi sepasang foton yang terjerat. Keduanya lalu dikirim ke tempat yang berjauhan.", "kata": [["Sebuah", 0.096541, 0.419832], ["kristal", 0.419833, 0.689208], ["khusus", 0.689208, 1.012499], ["membelah", 1.0125, 1.228], ["satu", 1.228, 1.411208], ["foton", 1.411208, 1.745249], ["menjadi", 1.74525, 2.025416], ["sepasang", 2.025416, 2.359457], ["foton", 2.3595, 2.650416], ["yang", 2.650416, 2.768957], ["terjerat", 2.768958, 3.253874], ["Keduanya", 3.968958, 4.346124], ["lalu", 4.346125, 4.572416], ["dikirim", 4.572416, 4.906457], ["ke", 4.906458, 4.971124], ["tempat", 4.971125, 5.262083], ["yang", 5.262083, 5.369833], ["berjauhan", 5.369833, 6.027166]]}, {"teks": "Sebelum diukur, hasil tiap foton belum tertentu. Saat satu diukur, hasilnya acak, tapi hasil pasangannya selalu berkorelasi dengannya.", "kata": [["Sebelum", 0.096541, 0.419832], ["diukur", 0.419833, 0.883208], ["hasil", 1.098708, 1.389666], ["tiap", 1.389666, 1.540499], ["foton", 1.5405, 1.820666], ["belum", 1.820708, 1.982333], ["tertentu", 1.982333, 2.531916], ["Saat", 3.247, 3.505583], ["satu", 3.505583, 3.699541], ["diukur", 3.699583, 4.173708], ["hasilnya", 4.389208, 4.766374], ["acak", 4.766375, 5.197416], ["tapi", 5.402166, 5.617666], ["hasil", 5.617666, 5.843957], ["pasangannya", 5.843958, 6.307333], ["selalu", 6.307333, 6.576708], ["berkorelasi", 6.576708, 7.040083], ["dengannya", 7.040083, 7.557333]]}, {"teks": "Ini bukan seperti sepasang sarung tangan yang sudah ditentukan dari awal. Eksperimen yang disebut uji Bell menunjukkan, korelasinya lebih kuat dari penjelasan biasa itu.", "kata": [["Ini", 0.096541, 0.333624], ["bukan", 0.333625, 0.559916], ["seperti", 0.559916, 0.829291], ["sepasang", 0.829291, 1.174124], ["sarung", 1.174125, 1.389625], ["tangan", 1.389666, 1.691374], ["yang", 1.691375, 1.809916], ["sudah", 1.809916, 2.003874], ["ditentukan", 2.003875, 2.413375], ["dari", 2.413375, 2.542666], ["awal", 2.542666, 3.006041], ["Eksperimen", 3.728458, 4.159499], ["yang", 4.1595, 4.26725], ["disebut", 4.26725, 4.568958], ["uji", 4.568958, 4.806041], ["Bell", 4.806041, 4.978457], ["menunjukkan", 4.978458, 5.581916], ["korelasinya", 5.851291, 6.325416], ["lebih", 6.325416, 6.508624], ["kuat", 6.508625, 6.713375], ["dari", 6.713375, 6.831916], ["penjelasan", 6.831916, 7.284499], ["biasa", 7.2845, 7.521541], ["itu", 7.521541, 7.920249]]}, {"teks": "Tapi penting: entanglement tidak bisa dipakai mengirim pesan lebih cepat dari cahaya. Hasil tiap sisi tetap tampak acak, sampai hasilnya dibandingkan lewat jalur biasa.", "kata": [["Tapi", 0.103875, 0.297833], ["penting", 0.297833, 0.761208], ["entanglement", 1.009041, 1.515499], ["tidak", 1.5155, 1.677125], ["bisa", 1.677166, 1.860332], ["dipakai", 1.860333, 2.162041], ["mengirim", 2.162083, 2.420708], ["pesan", 2.420708, 2.657749], ["lebih", 2.65775, 2.819375], ["cepat", 2.819416, 3.099582], ["dari", 3.099583, 3.250416], ["cahaya", 3.250416, 3.778416], ["Hasil", 4.497, 4.798708], ["tiap", 4.798708, 4.971124], ["sisi", 4.971125, 5.208208], ["tetap", 5.208208, 5.434499], ["tampak", 5.4345, 5.65], ["acak", 5.65, 6.07025], ["sampai", 6.307333, 6.598291], ["hasilnya", 6.598291, 6.943082], ["dibandingkan", 6.943083, 7.427999], ["lewat", 7.428, 7.621958], ["jalur", 7.622, 7.880583], ["biasa", 7.880583, 8.387041]]}, {"teks": "Eksperimen ini meraih Nobel Fisika 2022, dan kini menjadi dasar komunikasi kuantum yang aman serta komputer kuantum.", "kata": [["Eksperimen", 0.103875, 0.481041], ["ini", 0.481041, 0.696541], ["meraih", 0.696541, 0.912041], ["Nobel", 0.912083, 1.116791], ["Fisika", 1.116791, 1.461624], ["2022", 1.461625, 2.4314569], ["dan", 2.679291, 2.873249], ["kini", 2.873291, 3.067249], ["menjadi", 3.06725, 3.325875], ["dasar", 3.325875, 3.573708], ["komunikasi", 3.573708, 3.983208], ["kuantum", 3.983208, 4.317249], ["yang", 4.31725, 4.435791], ["aman", 4.435791, 4.726707], ["serta", 4.726708, 4.985333], ["komputer", 4.985333, 5.330166], ["kuantum", 5.330166, 5.868957]]}]