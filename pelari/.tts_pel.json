[{"teks": "Apa yang terjadi kalau seorang pria berlari mendekati kecepatan cahaya di Bumi? Mari kita iris Bumi dan udaranya.", "kata": [["Apa", 0.0955, 0.290166], ["yang", 0.290166, 0.392624], ["terjadi", 0.392625, 0.781958], ["kalau", 0.781958, 0.935666], ["seorang", 0.935666, 1.181541], ["pria", 1.181541, 1.355707], ["berlari", 1.35575, 1.663125], ["mendekati", 1.663125, 1.991], ["kecepatan", 1.991, 2.359833], ["cahaya", 2.359833, 2.646708], ["di", 2.646708, 2.718416], ["Bumi", 2.718458, 3.097541], ["Mari", 3.7795, 4.035666], ["kita", 4.035666, 4.199582], ["iris", 4.199583, 4.394249], ["Bumi", 4.39425, 4.650416], ["dan", 4.650416, 4.773374], ["udaranya", 4.773375, 5.336916]]}, {"teks": "Kecepatan cahaya sekitar 300.000 kilometer per detik, sementara keliling Bumi sekitar 40.000 kilometer.", "kata": [["Kecepatan", 0.10125, 0.449583], ["cahaya", 0.449583, 0.756958], ["sekitar", 0.756958, 1.074583], ["300.000", 1.074583, 1.6483319], ["kilometer", 1.648375, 1.966], ["per", 1.966, 2.058208], ["detik", 2.058208, 2.447541], ["sementara", 2.693458, 3.072541], ["keliling", 3.072541, 3.328707], ["Bumi", 3.328708, 3.584833], ["sekitar", 3.584833, 3.912708], ["40.000", 3.912708, 4.445457], ["kilometer", 4.4455, 4.998791]]}, {"teks": "Kalau pria itu mencapai 99 persen kecepatan cahaya, dia akan mengitari Bumi sekitar tujuh kali dalam satu detik.", "kata": [["Kalau", 0.10125, 0.275416], ["pria", 0.275416, 0.429082], ["itu", 0.429083, 0.633999], ["mencapai", 0.634, 0.961875], ["99", 0.961875, 1.5561659], ["persen", 1.556166, 1.791791], ["kecepatan", 1.791791, 2.129916], ["cahaya", 2.129916, 2.642207], ["dia", 2.898375, 3.072541], ["akan", 3.072541, 3.236457], ["mengitari", 3.236458, 3.502833], ["Bumi", 3.502875, 3.728291], ["sekitar", 3.728291, 4.035666], ["tujuh", 4.035666, 4.261082], ["kali", 4.261083, 4.496708], ["dalam", 4.496708, 4.711874], ["satu", 4.711875, 4.916791], ["detik", 4.916791, 5.213916]]}, {"teks": "Tapi masalah pertama: makin cepat, makin besar energi yang dibutuhkan. Mencapai kecepatan cahaya butuh energi tak terhingga untuk benda bermassa, jadi hanya bisa mendekati.", "kata": [["Tapi", 0.0955, 0.320916], ["masalah", 0.320916, 0.597541], ["pertama", 0.597541, 1.089332], ["makin", 1.325, 1.560666], ["cepat", 1.560666, 1.919291], ["makin", 2.113916, 2.349582], ["besar", 2.349583, 2.554499], ["energi", 2.5545, 2.882375], ["yang", 2.882375, 2.974583], ["dibutuhkan", 2.974583, 3.579083], ["Mencapai", 4.262291, 4.600416], ["kecepatan", 4.600416, 4.969249], ["cahaya", 4.96925, 5.266375], ["butuh", 5.266375, 5.450791], ["energi", 5.450833, 5.809416], ["tak", 5.809416, 5.942624], ["terhingga", 5.942625, 6.28075], ["untuk", 6.28075, 6.465166], ["benda", 6.465166, 6.639332], ["bermassa", 6.639333, 7.161874], ["jadi", 7.407791, 7.674166], ["hanya", 7.674166, 7.868832], ["bisa", 7.868833, 8.063499], ["mendekati", 8.063541, 8.586082]]}, {"teks": "Masalah kedua: udara. Pada kecepatan itu, molekul udara menumbuknya dengan energi sangat besar, dan udara di depannya berubah menjadi plasma panas yang meledak.", "kata": [["Masalah", 0.1, 0.479083], ["kedua", 0.479083, 0.950374], ["udara", 1.134833, 1.657374], ["Pada", 2.336083, 2.499999], ["kecepatan", 2.5, 2.827875], ["itu", 2.827875, 3.206958], ["molekul", 3.463125, 3.7705], ["udara", 3.7705, 3.995916], ["menumbuknya", 3.995916, 4.426249], ["dengan", 4.42625, 4.620916], ["energi", 4.620916, 4.907791], ["sangat", 4.907791, 5.122957], ["besar", 5.122958, 5.543041], ["dan", 5.758208, 5.911874], ["udara", 5.911875, 6.17825], ["di", 6.178291, 6.239749], ["depannya", 6.23975, 6.536875], ["berubah", 6.536875, 6.834], ["menjadi", 6.834, 7.100375], ["plasma", 7.100416, 7.377041], ["panas", 7.377041, 7.694666], ["yang", 7.694666, 7.797124], ["meledak", 7.797125, 8.206958]]}, {"teks": "Dari sudut pandang sang pelari, waktunya melambat, dan jalan di depannya memendek. Inilah dilatasi waktu dan kontraksi panjang dari relativitas khusus.", "kata": [["Dari", 0.10125, 0.285666], ["sudut", 0.285666, 0.511082], ["pandang", 0.511083, 0.746708], ["sang", 0.746708, 0.890166], ["pelari", 0.890166, 1.320499], ["waktunya", 1.545916, 1.883999], ["melambat", 1.884, 2.334833], ["dan", 2.5295, 2.724166], ["jalan", 2.724166, 2.970082], ["di", 2.970083, 3.031541], ["depannya", 3.031541, 3.328666], ["memendek", 3.328708, 3.779541], ["Inilah", 4.461458, 4.799583], ["dilatasi", 4.799583, 5.158208], ["waktu", 5.158208, 5.434833], ["dan", 5.434833, 5.588541], ["kontraksi", 5.588541, 5.936874], ["panjang", 5.936875, 6.2955], ["dari", 6.2955, 6.459416], ["relativitas", 6.459416, 6.940957], ["khusus", 6.941, 7.391833]]}, {"teks": "Bagi orang di sekitarnya, tubuhnya sudah berubah menjadi ledakan energi dalam sekejap. Tidak ada manusia yang bisa melakukannya di Bumi.", "kata": [["Bagi", 0.10125, 0.295916], ["orang", 0.295916, 0.480332], ["di", 0.480333, 0.531541], ["sekitarnya", 0.531541, 1.146291], ["tubuhnya", 1.392208, 1.730333], ["sudah", 1.730333, 1.894249], ["berubah", 1.89425, 2.181125], ["menjadi", 2.181166, 2.468041], ["ledakan", 2.468041, 2.744666], ["energi", 2.744666, 3.113499], ["dalam", 3.113541, 3.318457], ["sekejap", 3.318458, 3.820499], ["Tidak", 4.502458, 4.707374], ["ada", 4.707375, 4.850833], ["manusia", 4.850833, 5.219666], ["yang", 5.219666, 5.352874], ["bisa", 5.352875, 5.527041], ["melakukannya", 5.527041, 5.967624], ["di", 5.967625, 6.049583], ["Bumi", 6.049583, 6.449166]]}, {"teks": "Kecepatan cahaya adalah batas alam semesta. Hanya di ruang hampa, partikel bisa mendekatinya, misalnya di akselerator seperti LHC.", "kata": [["Kecepatan", 0.0955, 0.495083], ["cahaya", 0.495083, 0.843458], ["adalah", 0.843458, 1.099583], ["batas", 1.099583, 1.365958], ["alam", 1.366, 1.540166], ["semesta", 1.540166, 2.062707], ["Hanya", 2.740166, 3.006541], ["di", 3.006541, 3.088499], ["ruang", 3.088541, 3.252457], ["hampa", 3.252458, 3.723749], ["partikel", 3.949166, 4.328249], ["bisa", 4.328291, 4.512707], ["mendekatinya", 4.512708, 5.147958], ["misalnya", 5.363125, 5.752458], ["di", 5.752458, 5.834416], ["akselerator", 5.834416, 6.346707], ["seperti", 6.346708, 6.643833], ["LHC", 6.643833, 7.166374]]}]